<Window x:Class="SnipToolApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip Tool"
        Height="680"
        Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1115"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#FF111419" CornerRadius="22" BorderBrush="#FF2D3440" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                <Button x:Name="NewSnipButton" Content="New Snip" Width="120" Height="42" Click="NewSnip_Click" />
                <Button x:Name="StartRecordingButton" Content="Start Recording" Width="140" Height="42" Click="StartRecording_Click" />
                <Button x:Name="StopRecordingButton" Content="Stop Recording" Width="120" Height="42" Click="StopRecording_Click" IsEnabled="False" />
                <Button Content="Settings" Width="100" Height="42" Click="Settings_Click" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF191F27" CornerRadius="18" Padding="14" BorderBrush="#FF2F3846" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Preview" Foreground="#FFB6C4D6" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                        <Border Background="#FF12161C" CornerRadius="14" Height="420" ClipToBounds="True">
                            <Image x:Name="CapturePreview" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="PreviewHintText" Text="Capture result will appear here." Foreground="#FF8A98A8" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FF191F27" CornerRadius="18" Padding="14" BorderBrush="#FF2F3846" BorderThickness="1" Margin="18,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Status" Foreground="#FFB6C4D6" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#FF8A98A8" FontSize="14" TextWrapping="Wrap" />
                        <Separator Margin="0,14,0,14" />
                        <TextBlock Text="Recording" Foreground="#FFB6C4D6" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                        <TextBlock x:Name="RecordingText" Text="Stopped" Foreground="#FF8A98A8" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="FooterText" Text="Built with C# + XAML front-end and native C++ capture backend." Foreground="#FF6B7B8B" HorizontalAlignment="Center" Margin="0,0,0,4" />
        </Grid>
    </Border>
</Window>
