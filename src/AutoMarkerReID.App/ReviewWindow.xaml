<Window x:Class="AutoMarkerReID.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra kết quả nhận diện" Width="1100" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" KeyDown="OnKeyDown"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#090F1B" CornerRadius="8" ClipToBounds="True" MouseRightButtonUp="OnSaveClick">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="ImageSurface" MouseLeftButtonUp="OnImageClick">
                    <Image x:Name="PreviewImage" Stretch="None" />
                    <Canvas x:Name="BoxCanvas" Background="Transparent" />
                </Grid>
            </Viewbox>
        </Border>
        <Border Grid.Row="1" Background="#111827" CornerRadius="7" Padding="8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHI TIẾT NHẬN DIỆN" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="3,0,3,5"/>
                <ListBox x:Name="DiagnosticsList" Background="Transparent" BorderThickness="0" Foreground="#CBD5E1"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3,2"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="CẮT / CHỈNH SỬA" Click="OnEditClick" />
                <Button Content="HỦY" Click="OnCancelClick" />
                <Button Content="LƯU VÀ SAO CHÉP" Background="#0284C7" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
