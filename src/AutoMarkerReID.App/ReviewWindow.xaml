<Window x:Class="AutoMarkerReID.App.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra kết quả nhận diện" Width="1320" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" KeyDown="OnKeyDown"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>

        <Border Background="#090F1B" CornerRadius="8" ClipToBounds="True" MouseRightButtonUp="OnSaveClick">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="ImageSurface" MouseLeftButtonUp="OnImageClick">
                    <Image x:Name="PreviewImage" Stretch="None" />
                    <Canvas x:Name="BoxCanvas" Background="Transparent" />
                </Grid>
            </Viewbox>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="12,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="NGƯỠNG NHẬN DIỆN" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="2,0,2,6" />
                <TextBlock DockPanel.Dock="Top" x:Name="ThresholdText" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Margin="2,0,2,4" />
                <Slider DockPanel.Dock="Top" x:Name="ThresholdSlider" Minimum="0.50" Maximum="0.95"
                        SmallChange="0.01" LargeChange="0.05" TickFrequency="0.05"
                        Margin="2,0,2,6" ValueChanged="OnThresholdChanged" />
                <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="Nhận diện lại" ToolTip="Chạy lại nhận diện với ngưỡng vừa chọn"
                            Click="OnRematchClick" />
                    <Button Grid.Column="1" Content="Ngưỡng gốc" ToolTip="Bỏ ngưỡng thủ công, dùng lại ngưỡng tự hiệu chỉnh của Query"
                            Click="OnResetThresholdClick" Margin="6,0,0,0" />
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="PHÂN TÍCH TỪNG THẺ" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="2,4,2,6" />
                <ListBox x:Name="DiagnosticsList" Background="#0B1220" Foreground="#CBD5E1" BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalContentAlignment="Stretch"
                         SelectionChanged="OnDiagnosticSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Headline}" Foreground="{Binding Accent}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="HOÀN TÁC" ToolTip="Hoàn tác lần thêm hoặc xóa khung gần nhất · Ctrl+Z" Click="OnUndoClick" />
                <Button Content="HỦY" Click="OnCancelClick" />
                <Button Content="LƯU VÀ SAO CHÉP" Background="#0284C7" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
