<Window x:Class="AutoMarkerReID.App.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#33000000"
        ShowInTaskbar="False" Topmost="True" Cursor="Cross" KeyDown="OnKeyDown">
    <Canvas x:Name="SelectionCanvas" Background="Transparent"
            MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
        <Border x:Name="SelectionBorder" Visibility="Collapsed" BorderBrush="#38BDF8" BorderThickness="2" Background="#2238BDF8" />
        <Border Canvas.Left="20" Canvas.Top="20" Background="#DD111827" CornerRadius="7" Padding="12,8">
            <TextBlock Text="Kéo để chọn vùng · Esc để hủy" Foreground="White" />
        </Border>
    </Canvas>
</Window>
