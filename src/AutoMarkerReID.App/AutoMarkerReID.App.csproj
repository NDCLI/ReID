<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(StoreBuild)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(StoreBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AutoMarkerReID.App</AssemblyName>
    <Product>AutoMarker Re-ID</Product>
    <Company>AutoMarker Re-ID</Company>
    <Description>Local Windows application for person re-identification and result review.</Description>
    <Copyright>Copyright © 2026 AutoMarker Re-ID</Copyright>
    <Version>1.0.14</Version>
    <FileVersion>1.0.14.0</FileVersion>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
    <EnableMsixTooling Condition="'$(StoreBuild)' == 'true'">true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(StoreBuild)' == 'true'">MSIX</WindowsPackageType>
    <PublishAppxPackage Condition="'$(StoreBuild)' == 'true'">true</PublishAppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(StoreBuild)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled Condition="'$(StoreBuild)' == 'true'">false</AppxPackageSigningEnabled>
    <AppxBundle Condition="'$(StoreBuild)' == 'true'">Never</AppxBundle>
    <UapAppxPackageBuildMode Condition="'$(StoreBuild)' == 'true'">StoreOnly</UapAppxPackageBuildMode>
    <AppxPackageIncludePrivateSymbols Condition="'$(StoreBuild)' == 'true'">false</AppxPackageIncludePrivateSymbols>
    <AppxSymbolPackageEnabled Condition="'$(StoreBuild)' == 'true'">false</AppxSymbolPackageEnabled>
    <GenerateAppInstallerFile Condition="'$(StoreBuild)' == 'true'">false</GenerateAppInstallerFile>
    <SelfContained Condition="'$(StoreBuild)' == 'true'">true</SelfContained>
    <TargetPlatformVersion Condition="'$(StoreBuild)' == 'true'">10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(StoreBuild)' == 'true'">10.0.19041.0</TargetPlatformMinVersion>
    <MrmSupportLibraryPath Condition="'$(StoreBuild)' == 'true'">$(PkgMicrosoft_Windows_SDK_BuildTools)\bin\10.0.26100.0\x64\mrmsupport.dll</MrmSupportLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoMarkerReID.Application\AutoMarkerReID.Application.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Domain\AutoMarkerReID.Domain.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Imaging\AutoMarkerReID.Imaging.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Inference\AutoMarkerReID.Inference.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Persistence\AutoMarkerReID.Persistence.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Windows\AutoMarkerReID.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Condition="'$(StoreBuild)' == 'true'" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Condition="'$(StoreBuild)' == 'true'" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(StoreBuild)' == 'true'">
    <AppxManifest Include="$(StoreManifestPath)" />
    <Content Include="$(StoreAssetsPath)\**\*.png"
             Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
