<Window x:Class="AutoMarkerReID.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoMarker Re-ID" Height="720" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AutoMarker Re-ID" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Nhận diện, đánh dấu và thu thập Query hoàn toàn cục bộ" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PHẠM VI QUERY" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,2,4,10" />
                    <ListBox ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Summary}" Padding="5" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="THAO TÁC" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,2,4,10" />
                    <UniformGrid Columns="2">
                        <Button Content="Chụp vùng" Command="{Binding CaptureCommand}" />
                        <Button Content="Chụp lại" Command="{Binding RepeatCaptureCommand}" />
                        <Button Content="Thư viện" Command="{Binding OpenLibraryCommand}" />
                        <Button Content="Sửa ảnh" Command="{Binding EditImageCommand}" />
                        <Button Content="Ảnh chụp" Command="{Binding OpenLatestCaptureCommand}" />
                        <Button Content="Xóa Query" Command="{Binding DeleteQueryCommand}" />
                        <Button Content="Làm mới OCR" Command="{Binding RebuildCacheCommand}" />
                        <Button Content="Xóa log" Command="{Binding ClearLogCommand}" />
                    </UniformGrid>
                    <Separator Margin="4,14" />
                    <TextBlock Text="LƯU CROP VÀO" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,0,4,5" />
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetQuery, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Query trống" Command="{Binding SelectEmptyTargetCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <CheckBox Content="Khớp trang phục (LBP tie-break)" IsChecked="{Binding AppearanceEnabled}" />
                    <CheckBox Content="Lưu ảnh chụp vào Pictures\Screenshots" IsChecked="{Binding SaveCaptures}" />
                    <Button Content="{Binding HotkeyStatus}" Command="{Binding ShowHotkeysCommand}" HorizontalContentAlignment="Left"/>
                    <Border Background="#172033" CornerRadius="7" Padding="10" Margin="4,14,4,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Clipboard monitor luôn bật. Ảnh Re-ID sẽ mở Review; crop dọc hợp lệ được lưu vào Query đã chọn." />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,2,4,10" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding ActivityLog}" Background="#0B1220" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,2" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Margin="4,12,4,0" Foreground="{StaticResource MutedTextBrush}"
                   Text="Đóng cửa sổ sẽ ẩn ứng dụng xuống System Tray. Thoát thật từ menu Tray." />
    </Grid>
</Window>
