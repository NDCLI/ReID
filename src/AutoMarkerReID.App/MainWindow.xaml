<Window x:Class="AutoMarkerReID.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoMarker Re-ID" Height="820" Width="1180" MinHeight="620" MinWidth="980"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AutoMarker Re-ID" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Nhận diện, đánh dấu và quản lý ảnh tham chiếu ngay trên thiết bị" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PHẠM VI NHẬN DIỆN" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,2,4,3" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RecognitionScopeText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,4,7" />
                    <ListBox ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" Foreground="{Binding Foreground}"
                                           ToolTip="{Binding ToolTip}" Padding="5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="CÔNG CỤ" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,2,4,10" />
                    <UniformGrid Columns="2">
                        <Button Content="Chọn vùng chụp" ToolTip="Kéo chọn một vùng mới trên màn hình" Command="{Binding CaptureCommand}" />
                        <Button Content="Chụp lại vùng cũ" ToolTip="Chụp lại vùng đã chọn gần nhất" Command="{Binding RepeatCaptureCommand}" />
                        <Button Content="Kết quả đã lưu" ToolTip="Xem và chỉnh sửa các kết quả nhận diện đã lưu" Command="{Binding OpenLibraryCommand}" />
                        <Button Content="Chỉnh sửa ảnh" ToolTip="Mở một ảnh có sẵn để cắt, xóa dải hoặc ghép ảnh" Command="{Binding EditImageCommand}" />
                        <Button Content="Ảnh chụp gần đây" ToolTip="Xem các ảnh đã chụp và mở trình chỉnh sửa" Command="{Binding OpenLatestCaptureCommand}" />
                        <Button Content="Mở thư mục Queries" ToolTip="Mở thư mục chứa ảnh tham chiếu Query" Command="{Binding OpenQueriesFolderCommand}" />
                        <Button Content="Mở thư mục Output" ToolTip="Mở thư mục chứa kết quả nhận diện đã lưu" Command="{Binding OpenOutputFolderCommand}" />
                        <Button Content="Xóa toàn bộ dữ liệu" ToolTip="Xóa vĩnh viễn Query, cache AI và toàn bộ output" Command="{Binding DeleteQueryCommand}" />
                        <Button Content="Tạo lại dữ liệu AI" ToolTip="Tạo lại đặc trưng nhận diện và dữ liệu OCR từ ảnh Query" Command="{Binding RebuildCacheCommand}" />
                        <Button Content="Dọn nhật ký" ToolTip="Xóa toàn bộ nội dung nhật ký hoạt động" Command="{Binding ClearLogCommand}" />
                    </UniformGrid>
                    <Separator Margin="4,14" />
                    <TextBlock Text="LƯU ẢNH THAM CHIẾU VÀO" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="4,0,4,5" />
                    <TextBlock Text="{Binding TargetQueryText}" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,4,5" />
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding TargetQueries}" SelectedItem="{Binding TargetQuery}" Padding="7,5" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Chọn Query trống" ToolTip="Tìm Query chưa có ảnh tham chiếu · Phím tắt F2" Command="{Binding SelectEmptyTargetCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <CheckBox Content="Hỗ trợ đối chiếu trang phục (LBP)" ToolTip="Dùng đặc điểm trang phục để phân định các kết quả có độ tương đồng gần nhau" IsChecked="{Binding AppearanceEnabled}" />
                    <CheckBox Content="Tự động lưu ảnh chụp vào Pictures\Screenshots"
                              IsChecked="{Binding SaveCaptures, Mode=OneWay}" IsEnabled="False" />
                    <TextBlock Text="{Binding ClipboardSummary}" Margin="8,7,4,2" Foreground="#93C5FD" />
                    <Button Content="{Binding HotkeyStatus}" Command="{Binding ShowHotkeysCommand}" HorizontalContentAlignment="Left"/>
                    <Border Background="#172033" CornerRadius="7" Padding="10" Margin="4,10,4,0">
                        <StackPanel>
                            <TextBlock Text="TÌNH TRẠNG HỆ THỐNG" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding StartupHealthText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding StartupIssueText}" TextWrapping="Wrap" Foreground="#FCA5A5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#172033" CornerRadius="7" Padding="10" Margin="4,14,4,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Ứng dụng luôn theo dõi Clipboard. Ảnh Re-ID sẽ được mở để kiểm tra; ảnh người hợp lệ sẽ được lưu vào Query đã chọn." />
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,2,4,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Tất cả" Command="{Binding SetLogFilterCommand}" CommandParameter="All" Padding="8,4" Margin="2"/>
                            <Button Content="Cảnh báo" Command="{Binding SetLogFilterCommand}" CommandParameter="Warning" Padding="8,4" Margin="2"/>
                            <Button Content="Lỗi" Command="{Binding SetLogFilterCommand}" CommandParameter="Error" Padding="8,4" Margin="2"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LogList" ItemsSource="{Binding ActivityLog}" Background="#0B1220" Foreground="#CBD5E1" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="4,2" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Margin="4,12,4,0" Foreground="{StaticResource MutedTextBrush}"
                   Text="Khi đóng cửa sổ, ứng dụng vẫn tiếp tục chạy trong khay hệ thống. Chọn “Thoát ứng dụng” tại biểu tượng khay để kết thúc hoàn toàn." />
    </Grid>
</Window>
