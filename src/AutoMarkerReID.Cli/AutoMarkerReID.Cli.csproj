<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoMarkerReID.Application\AutoMarkerReID.Application.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Domain\AutoMarkerReID.Domain.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Imaging\AutoMarkerReID.Imaging.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Inference\AutoMarkerReID.Inference.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Persistence\AutoMarkerReID.Persistence.csproj" />
    <ProjectReference Include="..\AutoMarkerReID.Windows\AutoMarkerReID.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
